# Eden AI (primary text + embeddings gateway)
EDEN_AI_API_KEY=
EDEN_AI_BASE_URL=https://api.edenai.run/v3
EDEN_AI_MODEL=google/gemma-4-26b-a4b-it
EDEN_AI_EMBEDDING_DIMENSIONS=384
AI_TEXT_PROVIDER=eden
AI_IMAGE_PROVIDER=disabled
AI_MAX_INPUT_CHARS=120000
AI_MAX_MCQS_PER_REQUEST=100

# Optional xAI provider/image fallback
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=study-materials
